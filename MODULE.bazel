"""vscode-bazel"""

module(name = "vscode_bazel")

bazel_dep(name = "aspect_rules_js", version = "3.2.2")
bazel_dep(name = "aspect_rules_ts", version = "3.9.1")
bazel_dep(name = "bazel_lib", version = "3.5.0")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4")

# Tool versions come from the same files the JavaScript ecosystem uses, so
# Renovate and Dependabot keep them current without Bazel-specific config:
#   - Node.js: .nvmrc
#   - pnpm: the "packageManager" field in package.json
#   - TypeScript: devDependencies.typescript in package.json (exact version)
#   - esbuild, vsce, eslint, prettier, ...: pnpm-lock.yaml
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version_from_nvmrc = "//:.nvmrc")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version_from = "//:package.json",
)
use_repo(pnpm, "pnpm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version_from = "//:package.json")
use_repo(rules_ts_ext, "npm_typescript")

# npm packages from pnpm-lock.yaml. After changing dependencies in
# package.json, refresh the lockfile with `bazel run //:pnpm -- install
# --lockfile-only`.
#
# The repository gets a module-specific name rather than the conventional
# `npm`, so it can never be confused with another module's.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "vscode_bazel_npm",
    data = ["//:package.json"],
    pnpm_lock = "//:pnpm-lock.yaml",
    # vsce's secret scanner resolves its rule/formatter packages by bare name from
    # the root node_modules, which only works in npm's hoisted layout.
    # Hoist them so `//:vsix` can hand them to the vsce tool.
    public_hoist_packages = {
        "@secretlint/secretlint-formatter-sarif": [""],
        "@secretlint/secretlint-rule-no-dotenv": [""],
        "@secretlint/secretlint-rule-preset-recommend": [""],
    },
)
use_repo(npm, "vscode_bazel_npm")

# Makes package.json's version available to BUILD files as
# @package_version//:version.bzl.
package_version = use_repo_rule("//tools:package_version.bzl", "package_version")

package_version(
    name = "package_version",
    package_json = "//:package.json",
)
