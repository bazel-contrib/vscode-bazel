Subject: [PATCH] Misc updates (#13)

Just keeping things up to date.
---
 .bazeliskrc   |  2 +-
 .bazelrc      |  4 ++--
 .bazelversion |  2 +-
 Cargo.lock    |  4 ++--
 MODULE.bazel  | 20 ++++++++++----------
 5 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/.bazeliskrc b/.bazeliskrc
index 1060c4f..26065b8 100644
--- a/.bazeliskrc
+++ b/.bazeliskrc
@@ -1 +1 @@
-USE_BAZEL_VERSION=9.1.1
+USE_BAZEL_VERSION=9.3.1
diff --git a/.bazelrc b/.bazelrc
index 9d5b31b..abdd755 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -24,7 +24,7 @@ build:linux --incompatible_enable_cc_toolchain_resolution
 build:linux --action_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
 build:linux --extra_toolchains=@zig_sdk//toolchain:linux_arm64_gnu.2.17,@zig_sdk//toolchain:linux_amd64_gnu.2.17
 
-build:windows --nolegacy_external_runfiles
-
 build --incompatible_enable_proto_toolchain_resolution=true
 build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc=True
+
+common --repo_env=ASPECT_TOOLS_TELEMETRY=-all
diff --git a/.bazelversion b/.bazelversion
index 44931da..3b74042 100644
--- a/.bazelversion
+++ b/.bazelversion
@@ -1 +1 @@
-9.1.1
+9.3.1
diff --git a/Cargo.lock b/Cargo.lock
index fcd3f63..fea4fe4 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1,6 +1,6 @@
 # This file is automatically @generated by Cargo.
 # It is not intended for manual editing.
-version = 3
+version = 4
 
 [[package]]
 name = "addr2line"
@@ -1432,7 +1432,7 @@ checksum = "a8f112729512f8e442d81f95a8a7ddf2b7c6b8a1a6f509a95864142b30cab2d3"
 
 [[package]]
 name = "starpls"
-version = "0.1.22"
+version = "0.0.0"
 dependencies = [
  "annotate-snippets",
  "anstream",
diff --git a/MODULE.bazel b/MODULE.bazel
index dc3e1fc..ce03b2b 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
