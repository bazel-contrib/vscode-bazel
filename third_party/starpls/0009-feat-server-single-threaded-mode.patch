+    /// In inline mode, forwards pending file ids as one analysis request.
+    /// A no-op otherwise; the thread does it on its own schedule.
+    pub(crate) fn pump(&self) {
+        let (receiver, sink) = match &self.inline {
+            Some(inline) => inline,
+            None => return,
