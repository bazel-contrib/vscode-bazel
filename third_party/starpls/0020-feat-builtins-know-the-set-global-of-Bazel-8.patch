From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UebelAndre <github@uebelandre.com>
Date: Wed, 25 Nov 2026 12:05:26 -0800
Subject: [PATCH] feat(builtins): know the `set` global of Bazel 8

Bazel 8 added a `set` type (`--incompatible_enable_starlark_set`). The
bundled builtin definitions predate it, so every `set(...)` was reported
as not defined. The global is added to the `.bzl` and `BUILD` builtins,
returning a type the checker does not know, so uses of a set produce no
diagnostics either way; completion of its methods needs regenerated
builtin definitions and is left for that.
---
 crates/starpls_bazel/data/build.builtins.json | 18 ++++++++++++++++++
 crates/starpls_bazel/data/bzl.builtins.json   | 18 ++++++++++++++++++
 crates/starpls_ide/src/completions.rs         |  1 +
 3 files changed, 37 insertions(+)

diff --git a/crates/starpls_bazel/data/build.builtins.json b/crates/starpls_bazel/data/build.builtins.json
index 933b2ab..76db6f5 100644
--- a/crates/starpls_bazel/data/build.builtins.json
+++ b/crates/starpls_bazel/data/build.builtins.json
@@ -62,6 +62,24 @@
         ],
         "return_type": "None"
       }
+    },
+    {
+      "name": "set",
+      "doc": "Creates a new set containing the unique elements of the given iterable, preserving iteration order (Bazel 8 and later, `--incompatible_enable_starlark_set`). Sets are mutable and hashable-element-only; they support `in`, iteration, `len`, the operators `|`, `&`, `-`, `^` with other sets, and the methods `add`, `remove`, `discard`, `pop`, `clear`, `update`, `union`, `intersection`, `difference`, `symmetric_difference`, `issubset`, `issuperset` and `isdisjoint`.",
+      "callable": {
+        "params": [
+          {
+            "name": "elements",
+            "type": "Iterable",
+            "doc": "The elements of the new set; an iterable of hashable values. Empty when omitted.",
+            "default_value": "[]",
+            "is_mandatory": false,
+            "is_star_arg": false,
+            "is_star_star_arg": false
+          }
+        ],
+        "return_type": "set"
+      }
     }
   ]
 }
diff --git a/crates/starpls_bazel/data/bzl.builtins.json b/crates/starpls_bazel/data/bzl.builtins.json
index 3b41138..1f9a724 100644
--- a/crates/starpls_bazel/data/bzl.builtins.json
+++ b/crates/starpls_bazel/data/bzl.builtins.json
@@ -179,6 +179,24 @@
         ],
         "return_type": "tag_class"
       }
+    },
+    {
+      "name": "set",
+      "doc": "Creates a new set containing the unique elements of the given iterable, preserving iteration order (Bazel 8 and later, `--incompatible_enable_starlark_set`). Sets are mutable and hashable-element-only; they support `in`, iteration, `len`, the operators `|`, `&`, `-`, `^` with other sets, and the methods `add`, `remove`, `discard`, `pop`, `clear`, `update`, `union`, `intersection`, `difference`, `symmetric_difference`, `issubset`, `issuperset` and `isdisjoint`.",
+      "callable": {
+        "params": [
+          {
+            "name": "elements",
+            "type": "Iterable",
+            "doc": "The elements of the new set; an iterable of hashable values. Empty when omitted.",
+            "default_value": "[]",
+            "is_mandatory": false,
+            "is_star_arg": false,
+            "is_star_star_arg": false
+          }
+        ],
+        "return_type": "set"
+      }
     }
   ]
 }
diff --git a/crates/starpls_ide/src/completions.rs b/crates/starpls_ide/src/completions.rs
index 96177ed..897d186 100644
--- a/crates/starpls_ide/src/completions.rs
+++ b/crates/starpls_ide/src/completions.rs
@@ -691,6 +691,7 @@ $0
                 CompletionItem { label: "repr", kind: Function, mode: None, filter_text: None, relevance: Builtin }
                 CompletionItem { label: "reversed", kind: Function, mode: None, filter_text: None, relevance: Builtin }
                 CompletionItem { label: "rule", kind: Function, mode: None, filter_text: None, relevance: Builtin }
+                CompletionItem { label: "set", kind: Function, mode: None, filter_text: None, relevance: Builtin }
                 CompletionItem { label: "sorted", kind: Function, mode: None, filter_text: None, relevance: Builtin }
                 CompletionItem { label: "str", kind: Function, mode: None, filter_text: None, relevance: Builtin }
                 CompletionItem { label: "struct", kind: Function, mode: None, filter_text: None, relevance: Builtin }
