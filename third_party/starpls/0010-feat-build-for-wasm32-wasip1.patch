From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: UebelAndre <github@uebelandre.com>
Date: Thu, 19 Nov 2026 13:45:25 -0800
Subject: [PATCH] feat: build for wasm32-wasip1

`cargo build --target wasm32-wasip1` and `bazel build //:starpls_wasm`
produce a server for WASI preview 1 hosts such as the VS Code WebAssembly
runtime. On wasm the server is always single-threaded, rayon is left out
of the dependency graph, and path canonicalization is lexical. The Bazel
side registers the triple with the Rust toolchain, adds a `wasm32-wasip1`
platform and a transition target that builds the one `rust_binary` for
that platform in `opt`, so consumers need neither `--platforms` nor
`-c opt` (a fastbuild wasm is nearly three times the size); the existing
`bazel build //...` in CI covers it.

Bazel information comes from the client (see `crate::host`), since a WASI
process cannot run Bazel. The build is about 8.5 MB.
---
 BUILD.bazel               | 19 +++++++++++++++++
 MODULE.bazel              |  6 +++++-
 crates/starpls/Cargo.toml |  4 +++-
 wasm_binary.bzl           | 44 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 71 insertions(+), 2 deletions(-)
 create mode 100644 wasm_binary.bzl

diff --git a/BUILD.bazel b/BUILD.bazel
index ae5258d..84dbdad 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -1,5 +1,6 @@
 load("@rules_rust//rust:defs.bzl", "rust_library_group")
 load("@rules_rust_prost//:defs.bzl", "rust_prost_toolchain")
+load(":wasm_binary.bzl", "wasm_binary")
 
 exports_files(["rustfmt.toml"])
 
@@ -26,3 +27,21 @@ toolchain(
     toolchain = "prost_toolchain_impl",
     toolchain_type = "@rules_rust_prost//:toolchain_type",
 )
+
+# The server for WebAssembly hosts (WASI preview 1), e.g. the VS Code
+# WebAssembly runtime. `bazel build //:starpls_wasm` builds it without
+# `--platforms`; the binary runs single-threaded, see crates/starpls/src/single_thread.rs.
+platform(
+    name = "wasm32-wasip1",
+    constraint_values = [
+        "@platforms//cpu:wasm32",
+        "@platforms//os:wasi",
+    ],
+)
+
+wasm_binary(
+    name = "starpls_wasm",
+    binary = "//crates/starpls",
+    platform = ":wasm32-wasip1",
+    visibility = ["//visibility:public"],
+)
diff --git a/MODULE.bazel b/MODULE.bazel
index ce03b2b..eae7594 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -5,6 +5,7 @@ bazel_dep(name = "aspect_rules_js", version = "2.9.3")  # Needs lockfile update
 bazel_dep(name = "aspect_rules_swc", version = "2.7.6")
 bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
 bazel_dep(name = "bazel_skylib", version = "1.9.2")
+bazel_dep(name = "platforms", version = "1.0.0")
 bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")
 bazel_dep(name = "protobuf", version = "33.4")
 bazel_dep(name = "rules_proto", version = "7.1.0")
@@ -20,7 +21,10 @@ use_repo(zig_toolchains, "zig_sdk")
 rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
 rust.toolchain(
     edition = "2021",
-    extra_target_triples = ["aarch64-unknown-linux-gnu"],
+    extra_target_triples = [
+        "aarch64-unknown-linux-gnu",
+        "wasm32-wasip1",
+    ],
     versions = ["1.96.1"],
 )
 use_repo(rust, "rust_toolchains")
diff --git a/crates/starpls/Cargo.toml b/crates/starpls/Cargo.toml
index 118fe99..f78ce69 100644
--- a/crates/starpls/Cargo.toml
+++ b/crates/starpls/Cargo.toml
@@ -13,7 +13,6 @@ indexmap = "2.1.0"
 line-index = "0.1.0"
 lsp-server = "0.7.5"
 lsp-types = "0.94.1"
-rayon = "1.8.0"
 rustc-hash = "1.1.0"
 serde = "1.0.193"
 serde_json = "1.0.108"
@@ -28,3 +27,6 @@ log = "0.4.22"
 annotate-snippets = "0.11.5"
 anstream = "0.6.18"
 walkdir = "2.5.0"
+
+[target.'cfg(not(target_family = "wasm"))'.dependencies]
+rayon = "1.8.0"
diff --git a/wasm_binary.bzl b/wasm_binary.bzl
new file mode 100644
index 0000000..bc03722
--- /dev/null
+++ b/wasm_binary.bzl
@@ -0,0 +1,44 @@
+"""Builds a binary for a WebAssembly platform.
+
+The transition also forces an optimized build: a fastbuild wasm carries debug
+info and is several times larger, and a consumer that builds the artifact as
+a dependency has no reason to know about that.
+"""
+
+def _wasm_transition_impl(settings, attr):
+    return {
+        "//command_line_option:compilation_mode": "opt",
+        "//command_line_option:platforms": str(attr.platform),
+    }
+
+_wasm_transition = transition(
+    implementation = _wasm_transition_impl,
+    inputs = [],
+    outputs = [
+        "//command_line_option:compilation_mode",
+        "//command_line_option:platforms",
+    ],
+)
+
+def _wasm_binary_impl(ctx):
+    return [DefaultInfo(files = depset(ctx.files.binary))]
+
+wasm_binary = rule(
+    implementation = _wasm_binary_impl,
+    attrs = {
+        "binary": attr.label(
+            cfg = _wasm_transition,
+            allow_files = True,
+            doc = "The binary target to build for the platform.",
+            mandatory = True,
+        ),
+        "platform": attr.label(
+            doc = "The WebAssembly platform to build for.",
+            mandatory = True,
+        ),
+        "_allowlist_function_transition": attr.label(
+            default = "@bazel_tools//tools/allowlists/function_transition_allowlist",
+        ),
+    },
+    doc = "The given binary built for a WebAssembly platform, optimized.",
+)
