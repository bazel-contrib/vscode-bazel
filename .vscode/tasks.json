{
    "version": "2.0.0",
    "tasks": [
        {
            // Builds the extension and its tests, and places them under dist/
            // (plus a node_modules link) where the launch configurations and
            // the Extension Test Runner expect them.
            "label": "bazel: build",
            "type": "shell",
            "command": "bazel",
            "args": ["run", "//:build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$tsc"]
        }
    ]
}
