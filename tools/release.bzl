"""Rules for publishing the packaged extension.

Everything that leaves the build (Marketplace upload, GitHub release asset,
a copy for the workflow artifact) is a `bazel run` target that receives the
.vsix as a Bazel input, so callers never need to know where Bazel put it.
"""

def _github_release_upload_impl(ctx):
    script = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = script,
        content = """#!/usr/bin/env bash
# Generated by github_release_upload({label}).
set -euo pipefail
if [[ $# -lt 1 ]]; then
  echo "usage: bazel run {label} -- <release tag> [extra gh args]" >&2
  exit 1
fi
tag="$1"
shift
# `bazel run` starts us in the runfiles tree, where the asset sits at its
# workspace-relative path.
exec {gh} release upload "$tag" "{asset}" --clobber "$@"
""".format(
            label = "//%s:%s" % (ctx.label.package, ctx.label.name),
            gh = ctx.attr.gh,
            asset = ctx.file.asset.short_path,
        ),
        is_executable = True,
    )
    return DefaultInfo(
        executable = script,
        runfiles = ctx.runfiles(files = [ctx.file.asset]),
    )

github_release_upload = rule(
    implementation = _github_release_upload_impl,
    doc = """Uploads a built file to an existing GitHub release.

Usage: `bazel run <name> -- <tag>`. Authenticates like the `gh` CLI does
(GH_TOKEN or `gh auth login`). The asset keeps its Bazel file name.
""",
    attrs = {
        "asset": attr.label(
            doc = "The file to upload.",
            allow_single_file = True,
            mandatory = True,
        ),
        "gh": attr.string(
            doc = "The GitHub CLI executable to invoke (looked up on PATH).",
            default = "gh",
        ),
    },
    executable = True,
)

def _vscode_install_impl(ctx):
    script = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = script,
        content = """#!/usr/bin/env bash
# Generated by vscode_install({label}).
set -euo pipefail
# `bazel run` starts us in the runfiles tree, where the package sits at its
# workspace-relative path.
exec "${{VSCODE_BIN:-{code}}}" --install-extension "{vsix}" --force "$@"
""".format(
            label = "//%s:%s" % (ctx.label.package, ctx.label.name),
            code = ctx.attr.code,
            vsix = ctx.file.vsix.short_path,
        ),
        is_executable = True,
    )
    return DefaultInfo(
        executable = script,
        runfiles = ctx.runfiles(files = [ctx.file.vsix]),
    )

vscode_install = rule(
    implementation = _vscode_install_impl,
    doc = """Installs a built .vsix into the local VS Code.

Usage: `bazel run <name>`. Replaces an already installed copy. Set
VSCODE_BIN to install into another build, e.g.
`VSCODE_BIN=code-insiders bazel run <name>`.
""",
    attrs = {
        "vsix": attr.label(
            doc = "The packaged extension to install.",
            allow_single_file = [".vsix"],
            mandatory = True,
        ),
        "code": attr.string(
            doc = "The VS Code CLI to invoke by default (looked up on PATH).",
            default = "code",
        ),
    },
    executable = True,
)
