"""Run targets for a built .vsix.

They receive the package as a Bazel input, so callers never need to know
where Bazel put it.
"""

def _vscode_install_impl(ctx):
    script = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = script,
        content = """#!/usr/bin/env bash
# Generated by vscode_install({label}).
set -euo pipefail
# `bazel run` starts us in the runfiles tree, where the package sits at its
# workspace-relative path.
exec "${{VSCODE_BIN:-code}}" --install-extension "{vsix}" --force "$@"
""".format(
            # str(ctx.label) would print the canonical @@//... form.
            label = "//%s:%s" % (ctx.label.package, ctx.label.name),
            vsix = ctx.file.vsix.short_path,
        ),
        is_executable = True,
    )
    return DefaultInfo(
        executable = script,
        runfiles = ctx.runfiles(files = [ctx.file.vsix]),
    )

vscode_install = rule(
    implementation = _vscode_install_impl,
    doc = """Installs a built .vsix into the local VS Code.

Usage: `bazel run <name>`. Replaces an already installed copy. Set
VSCODE_BIN to install into another build, e.g.
`VSCODE_BIN=code-insiders bazel run <name>`.
""",
    attrs = {
        "vsix": attr.label(
            doc = "The packaged extension to install.",
            allow_single_file = [".vsix"],
            mandatory = True,
        ),
    },
    executable = True,
)
