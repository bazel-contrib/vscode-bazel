"""Run targets that act on the source tree rather than on Bazel outputs.

Formatters, lint fixers and the like want the checkout itself. A js_binary
started with `bazel run` works in its runfiles by default; this wrapper
points it at the checkout instead (via rules_js's JS_BINARY__CHDIR) so that
`bazel run //:format_fix` edits the real files.
"""

def _source_tree_tool_impl(ctx):
    script = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = script,
        content = """#!/usr/bin/env bash
# Generated by source_tree_tool({label}).
set -euo pipefail
if [[ -z "${{BUILD_WORKSPACE_DIRECTORY:-}}" ]]; then
  echo "{label} must be started with 'bazel run'" >&2
  exit 1
fi
{link_node_modules}
# The tool is a js_binary; JS_BINARY__CHDIR makes it run in the checkout.
export JS_BINARY__CHDIR="$BUILD_WORKSPACE_DIRECTORY"
exec "$PWD/{tool}" "$@"
""".format(
            label = "//%s:%s" % (ctx.label.package, ctx.label.name),
            tool = ctx.executable.tool.short_path,
            link_node_modules = """
# Node-based tooling run in the checkout resolves packages from
# node_modules/ there; point it at the packages Bazel linked.
if [[ ! -e "$BUILD_WORKSPACE_DIRECTORY/node_modules" ]]; then
  ln -s bazel-bin/node_modules "$BUILD_WORKSPACE_DIRECTORY/node_modules"
fi""" if ctx.attr.link_node_modules else "",
        ),
        is_executable = True,
    )
    runfiles = ctx.runfiles(files = [ctx.executable.tool]).merge(
        ctx.attr.tool[DefaultInfo].default_runfiles,
    )
    return DefaultInfo(executable = script, runfiles = runfiles)

source_tree_tool = rule(
    implementation = _source_tree_tool_impl,
    doc = """Runs a js_binary in the source tree. Arguments given via `args`
or after `--` are passed through.""",
    attrs = {
        "tool": attr.label(
            doc = "The js_binary to run.",
            executable = True,
            cfg = "target",
            mandatory = True,
        ),
        "link_node_modules": attr.bool(
            doc = "Ensure node_modules/ in the checkout links to Bazel's, for tools that resolve packages from the files they operate on.",
            default = False,
        ),
    },
    executable = True,
)
