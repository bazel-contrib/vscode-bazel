load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:write_source_files.bzl", "write_source_file")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")
load("@package_version//:version.bzl", "VERSION")
load("@vscode_bazel_npm//:@vscode/vsce/package_json.bzl", vsce_bin = "bin")
load("@vscode_bazel_npm//:defs.bzl", "npm_link_all_packages")
load("@vscode_bazel_npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@vscode_bazel_npm//:js-yaml/package_json.bzl", js_yaml_bin = "bin")
load("@vscode_bazel_npm//:prettier/package_json.bzl", prettier_bin = "bin")
load("@vscode_bazel_npm//:protobufjs-cli/package_json.bzl", pbjs_bin = "bin")
load("@vscode_bazel_npm//:vscode-tmgrammar-test/package_json.bzl", tmgrammar_bin = "bin")
load("//tools:release.bzl", "github_release_upload", "vscode_install")

npm_link_all_packages(name = "node_modules")

# The packaged extension's file name, versioned from package.json.
VSIX = "vscode-bazel-%s.vsix" % VERSION

# Make root-level source assets referenceable from subpackages
# (test/unit_runtime etc.).
exports_files(
    [
        "package.json",
        "syntaxes/bazelrc.configuration.json",
        "syntaxes/bazelrc.tmLanguage.yaml",
        "syntaxes/starlark.configuration.json",
        "syntaxes/starlark.tmLanguage.json",
    ],
    visibility = ["//visibility:public"],
)

# Static assets the extension loads at runtime (tree icons, marketplace
# logo). Shared by the packaged .vsix and the integration-test runtime tree.
filegroup(
    name = "assets",
    srcs = glob([
        "icons/*",
        "media/*",
    ]),
    visibility = ["//visibility:public"],
)

# Bazel-specific tsconfig — extends the checked-in tsconfig.json but
# drops outDir so tsc emits alongside sources in bazel-out. This is what
# lets test/*.test.ts import ../src/* — the compiled .d.ts files land at
# src/foo.d.ts (rather than dist/src/foo.d.ts), matching what TypeScript's
# module resolver looks for.
ts_config(
    name = "tsconfig",
    src = "tsconfig.bazel.json",
    visibility = ["//visibility:public"],
    deps = ["tsconfig.json"],
)

# Vendored Bazel .proto files, relative to src/protos/. Mirrors
# src/protos/protos_list.txt.
_PROTO_FILES = [
    "src/main/java/com/google/devtools/build/lib/buildeventstream/proto/build_event_stream.proto",
    "src/main/java/com/google/devtools/build/lib/skylarkdebug/proto/skylark_debugging.proto",
    "src/main/protobuf/build.proto",
    "src/main/protobuf/command_line.proto",
    "src/main/protobuf/invocation_policy.proto",
    "src/main/protobuf/option_filters.proto",
]

pbjs_bin.pbjs(
    name = "gen_protos_js",
    srcs = ["src/protos/%s" % f for f in _PROTO_FILES],
    outs = ["src/protos/protos.js"],
    args = [
        "--path",
        ".",
        "-t",
        "static-module",
        "-o",
        "protos.js",
    ] + _PROTO_FILES,
    chdir = "src/protos",
)

pbjs_bin.pbts(
    name = "gen_protos_dts",
    srcs = ["src/protos/protos.js"],
    outs = ["src/protos/protos.d.ts"],
    args = [
        "-o",
        "protos.d.ts",
        "protos.js",
    ],
    chdir = "src/protos",
)

# The generated proto module — grouped so the esbuild bundle and other
# consumers can depend on one label.
js_library(
    name = "protos_lib",
    srcs = [
        "src/protos/protos.d.ts",
        "src/protos/protos.js",
    ],
    visibility = ["//visibility:public"],
)

# Hand-written TypeScript sources. The generated protos.d.ts is excluded
# because `npm run prebuild` also writes it into the source tree; Bazel
# always uses its own generated copy (added explicitly below).
_TS_SRCS = glob(
    ["src/**/*.ts"],
    exclude = ["src/protos/protos.d.ts"],
)

# The whole non-test TypeScript compile. Adding protos.d.ts to srcs lets
# tsc resolve `../protos` (which points at src/protos/index.ts + protos.d.ts).
ts_project(
    name = "tsc",
    srcs = _TS_SRCS + ["src/protos/protos.d.ts"],
    allow_js = True,
    composite = True,
    data = ["src/protos/protos.js"],
    declaration = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig",
    visibility = ["//test:__pkg__"],
    deps = [":node_modules"],
)

# `bazel test //:typecheck` = "does every .ts under this project compile?"
# Equivalent of `npm run typecheck`.
build_test(
    name = "typecheck",
    targets = [
        ":tsc",
        "//test:tsc",
    ],
)

# Grammar codegen: yaml → json for the bazelrc TextMate grammar. Matches
# the yaml block in scripts/prepare.js. vscode-tmgrammar-snap and the
# packaged extension both consume the .json.
js_yaml_bin.js_yaml(
    name = "gen_bazelrc_tmlanguage_json",
    srcs = ["syntaxes/bazelrc.tmLanguage.yaml"],
    args = ["bazelrc.tmLanguage.yaml"],
    chdir = "syntaxes",
    stdout = "syntaxes/bazelrc.tmLanguage.json",
    visibility = ["//visibility:public"],
)

# Grammar snapshot test — mirrors `npm run test:grammar`. The tool reads
# package.json to find contributes.grammars, loads the .json grammar, and
# tokenizes example.bazelrc, comparing to the .snap. Runs from workspace
# root so all these paths resolve as they do in the npm script.
tmgrammar_bin.vscode_tmgrammar_snap_test(
    name = "grammar",
    args = ["test/example.bazelrc"],
    data = [
        "package.json",
        "syntaxes/bazelrc.tmLanguage.json",
        "syntaxes/starlark.tmLanguage.json",
        "//test:grammar_fixtures",
    ],
)

# The two bundles that ship in the extension, mirroring the
# `build:extension` / `build:debugadapter` npm scripts. Outputs land under
# dist/ so they sit where package.json's "main" (./dist/extension.js) and
# the debug adapter contribution expect them.
_BUNDLE_SRCS = _TS_SRCS + [
    "src/protos/protos.d.ts",
    "src/protos/protos.js",
]

[
    esbuild(
        name = name,
        srcs = _BUNDLE_SRCS,
        entry_point = entry_point,
        external = ["vscode"],
        format = "cjs",
        minify = True,
        output = "dist/%s.js" % output,
        platform = "node",
        target = "es2022",
        tsconfig = "tsconfig.json",
        visibility = ["//visibility:public"],
        deps = [":node_modules"],
    )
    for name, entry_point, output in [
        ("extension", "src/extension/extension.ts", "extension"),
        ("debug_adapter", "src/debug-adapter/client.ts", "debug-adapter-client"),
    ]
]

js_library(
    name = "dist",
    srcs = [
        ":debug_adapter",
        ":extension",
    ],
    visibility = ["//visibility:public"],
)

# Everything `vsce package` needs, laid out exactly as it is in a source
# checkout after `npm run build`. .vscodeignore does the final filtering,
# just as it does for the npm flow. Dependencies are bundled by esbuild, so
# no node_modules are needed (hence --no-dependencies below).
copy_to_directory(
    name = "vsix_staging",
    srcs = [
        ".vscodeignore",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "package.json",
        "syntaxes/bazelrc.configuration.json",
        "syntaxes/bazelrc.tmLanguage.json",
        "syntaxes/starlark.configuration.json",
        "syntaxes/starlark.tmLanguage.json",
        "syntaxes/starlark.tmLanguage.license",
        ":assets",
        ":dist",
    ],
)

# vsce scans the package for secrets with secretlint, which loads these
# rule and formatter packages by bare name from the root node_modules. They are hoisted
# there in MODULE.bazel; `data` here goes on the vsce tool so they are
# visible to it.
_VSCE_TOOL_DATA = [
    ":node_modules/@secretlint/secretlint-formatter-sarif",
    ":node_modules/@secretlint/secretlint-rule-no-dotenv",
    ":node_modules/@secretlint/secretlint-rule-preset-recommend",
]

# `bazel build //:vsix` packages the extension as vscode-bazel-<version>.vsix,
# the equivalent of `npm run package`. Consumers should depend on this
# target (or use the run targets below) rather than locate the file.
vsce_bin.vsce(
    name = "vsix",
    srcs = [":vsix_staging"],
    outs = [VSIX],
    args = [
        "package",
        "--no-dependencies",
        "--out",
        "../" + VSIX,
    ],
    chdir = "vsix_staging",
    data = _VSCE_TOOL_DATA,
)

# `VSCE_PAT=... bazel run //:publish` uploads the built .vsix to the
# Visual Studio Marketplace. Extra vsce flags can be appended, e.g.
# `bazel run //:publish -- --pre-release`.
vsce_bin.vsce_binary(
    name = "publish",
    args = [
        "publish",
        "--packagePath",
        "$(rootpath :vsix)",
    ],
    data = [":vsix"] + _VSCE_TOOL_DATA,
)

# `bazel run //:upload_release_asset -- <tag>` attaches the built .vsix to
# the GitHub release for <tag>, as the release workflow does.
github_release_upload(
    name = "upload_release_asset",
    asset = ":vsix",
)

# `bazel run //:install` installs the built .vsix into the local VS Code
# (VSCODE_BIN=code-insiders to target another build).
vscode_install(
    name = "install",
    vsix = ":vsix",
)

# `bazel run //:export_vsix` copies the built .vsix into the source tree
# root as vscode-bazel-<version>.vsix (git-ignored), e.g. for handing it to
# a CI artifact step. The file does not normally exist, so skip the
# up-to-date test.
write_source_file(
    name = "export_vsix",
    check_that_out_file_exists = False,
    diff_test = False,
    in_file = ":vsix",
    out_file = VSIX,
)

# Sources that prettier and eslint look at (`npm run format-check` /
# `npm run lint-check`). The root glob stops at the //test package, whose
# files come in through //test:lint_srcs.
filegroup(
    name = "lint_srcs",
    srcs = glob(
        [
            "**/*.js",
            "**/*.md",
            "**/*.ts",
            "**/*.yaml",
            "**/*.yml",
        ],
        exclude = [
            "pnpm-lock.yaml",
            "src/protos/protos.*",
        ],
    ) + [
        ".prettierignore",
        "package.json",
        "tsconfig.json",
    ],
)

# Starlark files to skip when running buildifier over the source tree: the
# test fixture workspace is test data (some of it deliberately unformatted),
# and node_modules may contain third-party BUILD files.
_BUILDIFIER_EXCLUDES = [
    "./node_modules/*",
    "./test/bazel_workspace/*",
]

# `bazel test //:buildifier_check` fails on formatting or lint findings in
# this repository's Starlark; `bazel run //:buildifier_fix` applies them.
buildifier_test(
    name = "buildifier_check",
    exclude_patterns = _BUILDIFIER_EXCLUDES,
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)

buildifier(
    name = "buildifier_fix",
    exclude_patterns = _BUILDIFIER_EXCLUDES,
    lint_mode = "fix",
    mode = "fix",
)

prettier_bin.prettier_test(
    name = "format",
    args = [
        "--check",
        ".",
    ],
    data = [
        ":lint_srcs",
        "//test:lint_srcs",
    ],
)

eslint_bin.eslint_test(
    name = "lint",
    args = ["."],
    data = [
        ":lint_srcs",
        ":node_modules",
        ":protos_lib",
        "//test:lint_srcs",
    ],
)
